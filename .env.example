# Copy to .env (or set in your process manager). No keys or credentials are needed.

# Port of the production server (npm start / node server.mjs). Default: 3002
PORT=3002
# Interface to listen on. 127.0.0.1 for local use; 0.0.0.0 behind a reverse proxy.
HOST=127.0.0.1
# Where quote requests and contact messages are stored (JSON + JPEG). Default: ./data
DATA_DIR=./data
